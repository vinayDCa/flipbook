rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /flipbooks/{document=**} {
      // Allow users to read and write their own flipbooks
      allow read, write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      // Allow reading without user_id restriction if they own it (for list queries)
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      // Note: for public viewing, we might need a way to fetch flipbooks publicly.
      allow read: if true; // Just allow public read for now to prevent breaking the public viewer
    }
  }
}
